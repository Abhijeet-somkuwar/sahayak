{
  "name": "sahayak-backend",
  "version": "1.0.0",
  "description": "Sahayak: AI-assisted OPD intake, triage, queue and doctor pre-brief platform for Indian government hospitals (backend, plain JavaScript).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint src test",
    "dev:api": "nodemon --watch src --ext js,lua src/apps/api.js",
    "dev:realtime": "nodemon --watch src --ext js src/apps/realtime.js",
    "dev:webhook": "nodemon --watch src --ext js src/apps/webhook.js",
    "dev:worker": "nodemon --watch src --ext js src/apps/worker.js",
    "dev:scheduler": "nodemon --watch src --ext js src/apps/scheduler.js",
    "dev:gateway": "node scripts/dev-gateway.js",
    "dev:all": "concurrently -n api,realtime,worker,gateway \"nodemon --watch src --watch .env --ext js,lua,env src/apps/api.js\" \"cross-env PORT=3001 nodemon --watch src --watch .env --ext js,lua,env src/apps/realtime.js\" \"nodemon --watch src --watch .env --ext js,lua,env src/apps/worker.js\" \"node scripts/dev-gateway.js\"",
    "start:api": "node src/apps/api.js",
    "start:realtime": "node src/apps/realtime.js",
    "start:webhook": "node src/apps/webhook.js",
    "start:worker": "node src/apps/worker.js",
    "start:scheduler": "node src/apps/scheduler.js",
    "db:migrate": "dbmate --url \"$DATABASE_URL_MAINT\" --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --url \"$DATABASE_URL_MAINT\" --migrations-dir db/migrations --no-dump-schema rollback",
    "db:migrate:node": "node scripts/migrate.js up",
    "db:rollback:node": "node scripts/migrate.js down",
    "db:seed": "node db/seeds/seed.js",
    "keys:gen": "node scripts/gen-keys.js",
    "eval": "node evals/run.js",
    "smoke": "node scripts/smoke.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:safety": "vitest run test/unit/clinical-safety.test.js",
    "load:surge": "k6 run load/morning-surge.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.60.0 <1.0.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": ">=0.58.0 <1.0.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0 <1.0.0",
    "@opentelemetry/sdk-node": ">=0.200.0 <1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.43.0",
    "bullmq": "^5.56.0",
    "croner": "^9.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.0",
    "fastify-type-provider-zod": "^5.0.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "kysely": ">=0.28.0 <1.0.0",
    "linkedom": "^0.18.0",
    "mammoth": "^1.9.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "pg-copy-streams": "^6.0.6",
    "pino": "^9.7.0",
    "prom-client": "^15.1.0",
    "sahayak": "file:..",
    "socket.io": "^4.8.0",
    "unpdf": "^1.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@testcontainers/postgresql": "^10.28.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "dbmate": "^2.26.0",
    "eslint": "^9.25.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.0",
    "testcontainers": "^10.28.0",
    "vitest": "^3.2.0"
  }
}
