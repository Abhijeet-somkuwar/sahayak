{
  "_comment": "DEMO — NOT FOR CLINICAL USE. Illustrative rule set in the §9.4 DSL. Real rules MUST be authored and approved by clinicians (four-eyes).",
  "notes": "DEMO — not for clinical use. Seeded for the assignment demo only.",
  "rules": {
    "emergency_phrases": {
      "en": ["chest pain", "can't breathe", "cannot breathe", "not breathing", "unconscious", "fits", "seizure", "heavy bleeding", "snake bite", "poison", "overdose", "stroke", "heart attack", "not responding", "labour pain", "baby not moving"],
      "hi": ["सीने में दर्द", "सांस नहीं", "बेहोश", "दौरे", "मिर्गी", "बहुत खून", "सांप", "ज़हर", "लकवा", "हार्ट अटैक", "होश नहीं", "प्रसव पीड़ा"],
      "hi-Latn": ["seene mein dard", "chhati mein dard", "saans nahi", "saans nahi aa rahi", "behosh", "daure", "mirgi", "jhatke", "bahut khoon", "saanp", "saap ne kata", "zehar", "zahar", "lakwa", "heart attack", "hosh nahi", "prasav"],
      "gu": ["છાતીમાં દુખાવો", "શ્વાસ નથી", "બેભાન", "ખેંચ", "આંચકી", "ખૂબ લોહી", "સાપ", "ઝેર", "લકવો", "હાર્ટ એટેક"]
    },
    "self_harm_phrases": { "en": ["want to end it all"], "hi-Latn": ["jeena nahi chahta", "jeena nahi chahti"] },
    "rules": [
      { "id": "EM-RED-FLAG-SYMPTOM", "level": "emergency", "description": "Any red-flag symptom code", "when": { "fact": "symptoms", "op": "contains_any", "value": ["SYM_UNCONSCIOUS", "SYM_SEIZURE", "SYM_CHEST_PAIN", "SYM_BREATHLESS", "SYM_VOMIT_BLOOD", "SYM_WEAKNESS_ONE_SIDE", "SYM_CONFUSION", "SYM_SEVERE_HEADACHE", "SYM_ROAD_ACCIDENT", "SYM_BURN", "SYM_HEAVY_BLEEDING", "SYM_SNAKE_BITE", "SYM_POISONING", "SYM_HEAD_INJURY", "SYM_VISION_LOSS", "SYM_NO_URINE", "SYM_PREGNANCY_BLEEDING", "SYM_LABOUR_PAIN", "SYM_REDUCED_FETAL_MOVEMENT", "SYM_SELF_HARM", "SYM_CHILD_LETHARGIC", "SYM_CHILD_FAST_BREATHING", "SYM_LOW_SUGAR", "SYM_ALLERGIC_REACTION", "SYM_SWEATING_COLD", "SYM_JAW_ARM_PAIN", "SYM_BLEEDING_GUMS_NOSE_FEVER", "SYM_STIFF_NECK_FEVER", "SYM_SPEECH_DIFFICULTY", "SYM_UNABLE_TO_WALK", "SYM_TESTICLE_PAIN", "SYM_POSTPARTUM_BLEEDING", "SYM_SWALLOWED_OBJECT", "SYM_EYE_INJURY", "SYM_DEHYDRATION"] } },
      { "id": "EM-BREATHLESS-REST", "level": "emergency", "when": { "fact": "breathless_at_rest", "op": "==", "value": true } },
      { "id": "EM-CHEST-PAIN-30", "level": "emergency", "when": { "all": [ { "fact": "chest_pain", "op": "==", "value": true }, { "fact": "age_years", "op": ">=", "value": 30 } ] } },
      { "id": "EM-CHEST-PAIN-YOUNG", "level": "priority", "when": { "all": [ { "fact": "chest_pain", "op": "==", "value": true }, { "fact": "age_years", "op": "<", "value": 30 } ] } },
      { "id": "EM-UNCONSCIOUS", "level": "emergency", "when": { "fact": "unconscious_or_confused", "op": "==", "value": true } },
      { "id": "EM-SEIZURE", "level": "emergency", "when": { "fact": "seizure_now", "op": "==", "value": true } },
      { "id": "EM-HEAVY-BLEEDING", "level": "emergency", "when": { "fact": "heavy_bleeding", "op": "==", "value": true } },
      { "id": "EM-STROKE-SIGNS", "level": "emergency", "when": { "fact": "weakness_one_side", "op": "==", "value": true } },
      { "id": "EM-WORST-HEADACHE", "level": "emergency", "when": { "fact": "headache_sudden_severe", "op": "==", "value": true } },
      { "id": "EM-STIFF-NECK-FEVER", "level": "emergency", "when": { "all": [ { "fact": "stiff_neck", "op": "==", "value": true }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_FEVER", "SYM_HIGH_FEVER", "SYM_HEADACHE"] } ] } },
      { "id": "EM-VOMIT-BLOOD", "level": "emergency", "when": { "fact": "vomit_blood", "op": "==", "value": true } },
      { "id": "EM-RIGID-ABDOMEN", "level": "emergency", "when": { "fact": "abdomen_rigid", "op": "==", "value": true } },
      { "id": "EM-DEHYDRATION", "level": "emergency", "when": { "fact": "dehydration_signs", "op": "==", "value": true } },
      { "id": "EM-HEAD-INJURY-FLAGS", "level": "emergency", "when": { "fact": "head_injury_red_flags", "op": "==", "value": true } },
      { "id": "EM-BURN-LARGE", "level": "emergency", "when": { "fact": "burn_extent", "op": "in", "value": ["medium", "large"] } },
      { "id": "EM-PREG-BLEED", "level": "emergency", "when": { "fact": "pregnancy_bleeding", "op": "==", "value": true } },
      { "id": "EM-FETAL-MOVEMENT", "level": "emergency", "when": { "fact": "fetal_movement_reduced", "op": "==", "value": true } },
      { "id": "EM-PREECLAMPSIA", "level": "emergency", "when": { "all": [ { "fact": "pregnant", "op": "==", "value": true }, { "fact": "pregnancy_headache_swelling", "op": "==", "value": true } ] } },
      { "id": "EM-INFANT-FEVER", "level": "emergency", "when": { "all": [ { "fact": "baby_age_months", "op": "<", "value": 3 }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_FEVER", "SYM_HIGH_FEVER", "SYM_INFANT_FEVER"] } ] } },
      { "id": "EM-CHILD-DANGER-SIGNS", "level": "emergency", "when": { "any": [ { "fact": "child_fast_breathing", "op": "==", "value": true }, { "fact": "child_lethargic", "op": "==", "value": true } ] } },
      { "id": "EM-HYPO", "level": "emergency", "when": { "all": [ { "fact": "hypo_symptoms", "op": "==", "value": true }, { "fact": "chronic", "op": "contains", "value": "diabetes" } ] } },
      { "id": "EM-AIRWAY", "level": "emergency", "when": { "fact": "cannot_swallow_saliva", "op": "==", "value": true } },
      { "id": "EM-SELF-HARM", "level": "emergency", "when": { "fact": "self_harm_thoughts", "op": "==", "value": true } },
      { "id": "EM-NO-URINE", "level": "emergency", "when": { "fact": "no_urine_12h", "op": "==", "value": true } },
      { "id": "EM-PALPITATION-SYNCOPE", "level": "emergency", "when": { "fact": "palpitation_with_faint", "op": "==", "value": true } },
      { "id": "EM-RASH-ANAPHYLAXIS", "level": "emergency", "when": { "fact": "rash_spreading_fast", "op": "==", "value": true } },
      { "id": "EM-EYE-INJURY", "level": "emergency", "when": { "fact": "eye_injury", "op": "==", "value": true } },
      { "id": "PR-FEVER-5D", "level": "priority", "when": { "fact": "fever_days", "op": ">=", "value": 5 } },
      { "id": "PR-FEVER-HIGH", "level": "priority", "when": { "fact": "fever_above_103", "op": "==", "value": true } },
      { "id": "PR-FEVER-RASH", "level": "priority", "when": { "fact": "fever_with_rash", "op": "==", "value": true } },
      { "id": "PR-INFANT-FEVER", "level": "priority", "when": { "all": [ { "fact": "age_years", "op": "<", "value": 1 }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_FEVER", "SYM_CHILD_COUGH", "SYM_CHILD_DIARRHOEA"] } ] } },
      { "id": "PR-UNDER5-NOT-DRINKING", "level": "priority", "when": { "all": [ { "fact": "age_years", "op": "<", "value": 5 }, { "fact": "child_feeding_ok", "op": "==", "value": false } ] } },
      { "id": "PR-DIARRHOEA-NOT-DRINKING", "level": "priority", "when": { "fact": "drinking_fluids", "op": "==", "value": false } },
      { "id": "PR-SEVERE-PAIN", "level": "priority", "when": { "fact": "pain_score", "op": ">=", "value": 8 } },
      { "id": "PR-BLACK-STOOL", "level": "priority", "when": { "fact": "black_stool", "op": "==", "value": true } },
      { "id": "PR-COUGH-BLOOD", "level": "priority", "when": { "fact": "cough_blood", "op": "==", "value": true } },
      { "id": "PR-JAUNDICE", "level": "priority", "when": { "fact": "yellow_eyes", "op": "==", "value": true } },
      { "id": "PR-DEFORMITY", "level": "priority", "when": { "any": [ { "fact": "limb_deformity", "op": "==", "value": true }, { "fact": "can_bear_weight", "op": "==", "value": false } ] } },
      { "id": "PR-DOG-BITE", "level": "priority", "when": { "fact": "symptoms", "op": "contains", "value": "SYM_DOG_BITE" } },
      { "id": "PR-ELDERLY-FALL", "level": "priority", "when": { "all": [ { "fact": "age_years", "op": ">=", "value": 60 }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_FALL_INJURY", "SYM_ELDERLY_FALL"] } ] } },
      { "id": "PR-PYELO", "level": "priority", "when": { "fact": "urine_with_fever", "op": "==", "value": true } },
      { "id": "PR-VISION", "level": "priority", "when": { "fact": "vision_change", "op": "==", "value": true } },
      { "id": "PR-DENTAL-ABSCESS", "level": "priority", "when": { "fact": "face_swelling_dental", "op": "==", "value": true } },
      { "id": "PR-MASTOID", "level": "priority", "when": { "fact": "ear_with_fever", "op": "==", "value": true } },
      { "id": "PR-FRACTURE-SUSPECT", "level": "priority", "when": { "fact": "symptoms", "op": "contains", "value": "SYM_FRACTURE_SUSPECT" } },
      { "id": "PR-PREGNANT-ANY-ACUTE", "level": "priority", "when": { "all": [ { "fact": "pregnant", "op": "==", "value": true }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_FEVER", "SYM_ABD_PAIN", "SYM_VOMITING", "SYM_HEADACHE", "SYM_DIARRHOEA", "SYM_BURNING_URINE"] } ] } },
      { "id": "PR-CHRONIC-ACUTE", "level": "priority", "description": "Diabetic / heart / kidney patients with breathlessness, fever or infection signs", "when": { "all": [ { "fact": "chronic", "op": "contains_any", "value": ["diabetes", "heart_disease", "kidney_disease", "ckd"] }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_FEVER", "SYM_BREATHLESS", "SYM_FOOT_ULCER", "SYM_VOMITING", "SYM_SWELLING_FEET"] } ] } },
      { "id": "PR-MENTAL-HEALTH-2W", "level": "priority", "when": { "all": [ { "fact": "low_mood_over_2_weeks", "op": "==", "value": true }, { "fact": "symptoms", "op": "contains_any", "value": ["SYM_DEPRESSION", "SYM_ANXIETY"] } ] } }
    ],
    "self_care": {
      "allowed_symptoms": ["SYM_COLD", "SYM_SORE_THROAT", "SYM_BODY_ACHE", "SYM_CONSTIPATION", "SYM_BLOATING", "SYM_INSECT_BITE", "SYM_ACNE", "SYM_MUSCLE_CRAMP", "SYM_SPRAIN", "SYM_HICCUPS"],
      "max_duration_hours": 72,
      "exclude_if_any": [
        { "fact": "age_years", "op": "<", "value": 5 },
        { "fact": "age_years", "op": ">=", "value": 60 },
        { "fact": "pregnant", "op": "==", "value": true },
        { "fact": "chronic", "op": "not_empty" },
        { "fact": "pain_score", "op": ">=", "value": 5 }
      ],
      "required_facts": ["duration_hours"]
    },
    "routing": [
      { "when": { "fact": "pregnant", "op": "==", "value": true }, "specialty": "obgyn" },
      { "when": { "fact": "age_years", "op": "<", "value": 14 }, "specialty": "paediatrics" },
      { "when": { "fact": "symptoms", "op": "contains_any", "value": ["SYM_CUT_WOUND", "SYM_BOIL", "SYM_LUMP", "SYM_HERNIA", "SYM_PILES", "SYM_FOOT_ULCER"] }, "specialty": "general_surgery" }
    ],
    "default_level": "routine"
  },
  "test_cases": [
    { "name": "55y chest pain is emergency", "facts": { "age_years": 55, "sex": "male", "symptoms": ["SYM_CHEST_PAIN"], "chronic": [] }, "expect": { "level": "emergency", "fired": ["EM-RED-FLAG-SYMPTOM"] } },
    { "name": "25y chest pain reported as a fact is priority (not emergency) when no red-flag code", "facts": { "age_years": 25, "sex": "male", "symptoms": ["SYM_ABD_BURN"], "chest_pain": true, "chronic": [] }, "expect": { "level": "priority", "fired": ["EM-CHEST-PAIN-YOUNG"] } },
    { "name": "breathless at rest is emergency at any age", "facts": { "age_years": 20, "sex": "female", "symptoms": ["SYM_COUGH"], "breathless_at_rest": true, "chronic": [] }, "expect": { "level": "emergency" } },
    { "name": "fever 5 days is priority", "facts": { "age_years": 30, "sex": "male", "symptoms": ["SYM_FEVER"], "fever_days": 5, "chronic": [] }, "expect": { "level": "priority", "fired": ["PR-FEVER-5D"] } },
    { "name": "fever 2 days routine, duration known", "facts": { "age_years": 30, "sex": "male", "symptoms": ["SYM_FEVER"], "fever_days": 2, "duration_hours": 48, "chronic": [] }, "expect": { "level": "routine" } },
    { "name": "infant with fever is priority", "facts": { "age_years": 0, "sex": "female", "symptoms": ["SYM_FEVER"], "chronic": [] }, "expect": { "level": "priority", "specialty": "paediatrics" } },
    { "name": "baby under 3 months with fever is emergency", "facts": { "age_years": 0, "sex": "male", "symptoms": ["SYM_FEVER"], "baby_age_months": 2, "chronic": [] }, "expect": { "level": "emergency" } },
    { "name": "cold in a pregnant woman is never self-care; routed to obgyn", "facts": { "age_years": 26, "sex": "female", "symptoms": ["SYM_COLD"], "pregnant": true, "duration_hours": 24, "pain_score": 1, "chronic": [] }, "expect": { "level": "routine", "specialty": "obgyn", "self_care_eligible": false } },
    { "name": "simple cold, 1 day, healthy adult is self-care", "facts": { "age_years": 30, "sex": "male", "symptoms": ["SYM_COLD"], "duration_hours": 24, "pain_score": 1, "pregnant": false, "chronic": [] }, "expect": { "level": "self_care", "self_care_eligible": true } },
    { "name": "cold with unknown duration is NOT self-care (facts must be known)", "facts": { "age_years": 30, "sex": "male", "symptoms": ["SYM_COLD"], "pregnant": false, "chronic": [] }, "expect": { "level": "routine", "self_care_eligible": false } },
    { "name": "cold in a diabetic is not self-care", "facts": { "age_years": 45, "sex": "male", "symptoms": ["SYM_COLD"], "duration_hours": 24, "chronic": ["diabetes"] }, "expect": { "level": "routine", "self_care_eligible": false } },
    { "name": "cold in a 65 year old is not self-care", "facts": { "age_years": 65, "sex": "female", "symptoms": ["SYM_COLD"], "duration_hours": 24, "pregnant": false, "chronic": [] }, "expect": { "level": "routine", "self_care_eligible": false } },
    { "name": "child not drinking is priority", "facts": { "age_years": 3, "sex": "male", "symptoms": ["SYM_CHILD_DIARRHOEA"], "child_feeding_ok": false, "chronic": [] }, "expect": { "level": "priority", "specialty": "paediatrics" } },
    { "name": "dehydration signs are emergency", "facts": { "age_years": 40, "sex": "male", "symptoms": ["SYM_DIARRHOEA"], "dehydration_signs": true, "chronic": [] }, "expect": { "level": "emergency" } },
    { "name": "diabetic with hypo symptoms is emergency", "facts": { "age_years": 50, "sex": "female", "symptoms": ["SYM_DIZZINESS"], "hypo_symptoms": true, "chronic": ["diabetes"] }, "expect": { "level": "emergency" } },
    { "name": "non-diabetic with sweating/shaking is routine (rule needs diabetes)", "facts": { "age_years": 50, "sex": "female", "symptoms": ["SYM_DIZZINESS"], "hypo_symptoms": true, "duration_hours": 2, "chronic": [] }, "expect": { "level": "routine" } },
    { "name": "elderly fall is priority", "facts": { "age_years": 72, "sex": "male", "symptoms": ["SYM_FALL_INJURY"], "chronic": [] }, "expect": { "level": "priority" } },
    { "name": "severe pain is priority", "facts": { "age_years": 35, "sex": "female", "symptoms": ["SYM_BACK_PAIN"], "pain_score": 8, "chronic": [] }, "expect": { "level": "priority" } },
    { "name": "cut wound routes to general surgery", "facts": { "age_years": 35, "sex": "male", "symptoms": ["SYM_CUT_WOUND"], "heavy_bleeding": false, "chronic": [] }, "expect": { "level": "routine", "specialty": "general_surgery" } },
    { "name": "stiff neck with fever is emergency", "facts": { "age_years": 22, "sex": "male", "symptoms": ["SYM_FEVER", "SYM_HEADACHE"], "stiff_neck": true, "chronic": [] }, "expect": { "level": "emergency" } }
  ]
}
