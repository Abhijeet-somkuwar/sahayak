# Local development only. Production secrets come from a secret manager (§13.7).
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Database (§19). App role through PgBouncer; owner role direct to Postgres.
DATABASE_URL=postgres://sahayak_api:dev@localhost:6432/sahayak
DATABASE_URL_MAINT=postgres://sahayak_maint:dev@localhost:5434/sahayak
DATABASE_REPLICA_URL=postgres://sahayak_analytics:dev@localhost:5434/sahayak

# Redis: two deployments (D13)
REDIS_CORE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380

# Object storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sahayak
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Keys. DEV_MASTER_KEY: base64 of 32 random bytes (dev only; prod uses KMS_KEY_ID).
DEV_MASTER_KEY=c2FoYXlhay1kZXYtbWFzdGVyLWtleS0zMi1ieXRlcyE=
BLIND_INDEX_KEY=c2FoYXlhay1kZXYtYmxpbmQtaW5kZXgtMzJieXRlcyE=
# Generate with: npm run keys:gen
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# WhatsApp Cloud API
WA_APP_SECRET=dev-wa-app-secret
WA_VERIFY_TOKEN=dev-verify-token
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# LLM gateway (section 10). Models are config, not code.
# LLM_PROVIDER=anthropic -> ANTHROPIC_API_KEY (+ optional in-country ANTHROPIC_BASE_URL)
# LLM_PROVIDER=openai    -> any OpenAI-compatible API: OPENAI_BASE_URL + OPENAI_API_KEY
#   Groq:   https://api.groq.com/openai/v1              models e.g. openai/gpt-oss-20b (fast), openai/gpt-oss-120b (smart)
#   OpenAI: https://api.openai.com/v1                   models e.g. gpt-4.1-mini (fast), gpt-4.1 (smart)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai   models e.g. gemini-2.5-flash
LLM_PROVIDER=anthropic
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_SMART=claude-sonnet-5-5
LLM_DAILY_TOKEN_BUDGET_PER_FACILITY=2000000
# Offshore providers (Groq, OpenAI, Gemini) need this to receive de-identified patient context
LLM_ALLOW_OFFSHORE_PATIENT_CONTEXT=false

# Embeddings (§20 open decision 2). 'mock' is deterministic and for dev/tests only.
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=mock-1024
EMBEDDINGS_DIM=1024

# Optional providers
ASR_PROVIDER=none
SMS_PROVIDER=log
OTEL_EXPORTER_OTLP_ENDPOINT=

# Host port for the Postgres container (change if 5434 is busy)
POSTGRES_HOST_PORT=5434
